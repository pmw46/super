.SH NAME
niccli \- Broadcom NIC configuration utility
.SH SYNOPSIS
.TP
niccli [-h|--help] <command>
.TP
niccli --version
.TP
niccli [--list | --list_devices | --list_ethernet]
.TP
niccli [--dev <index | SS:BB:DD.F | mac | NIC interface] <cmdline>
.TP
niccli [--pci <SS:BB:DD.F> <cmdline>
.TP
niccli [-i <index>] <cmdline>
.TP
niccli -i <index> --help
.TP

niccli -i <index> show --all
           show [-d|--device_info]
           show -p|--pkg_ver [-f <firmware package>]
           show -D|--device_pci_ids [-f <firmware package>]
